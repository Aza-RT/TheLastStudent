config_version=5

[application]
config/name="THE LAST STUDENT: AITU Night Shift - Escape"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
Inventory="*res://scripts/autoload/inventory.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025,0.04,0.065,1)

[tls]
rendering/raw_opengl=true
